      <a class="open" href={BASE + "/wizards/project.html"} target="_blank" rel="noopener">新窗口打开 ↗</a>
    </div>
    <iframe src={BASE + "/wizards/project.html"} title="自选课题 · 启动提示词"></iframe>
  </div>
</MingShell>
