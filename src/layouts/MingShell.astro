---
import "../styles/global.css";
import "../styles/theme.css";
import { loadDocs } from "../lib/docs.js";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = loadDocs();
const current = Astro.props.current || "";
const tints = ["c0", "c1", "c2", "c3"];

const tools = [
  { key: "demo", label: "四幕演示 · 水果店", href: BASE + "/demo/fruitlab/" },
  { key: "fruitlab", label: "起手引导 · 水果店", href: BASE + "/wizard/fruitlab/" },
  { key: "rag", label: "向导 · 知识问答（卡一）", href: BASE + "/wizard/rag/" },
  { key: "sql", label: "向导 · 数据问数（卡二）", href: BASE + "/wizard/sql/" },
  { key: "contract", label: "向导 · 合同审查（卡三）", href: BASE + "/wizard/contract/" },
  { key: "project", label: "课题开工向导（第三篇）", href: BASE + "/wizard/project/" }
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" href={BASE + "/favicon.svg"} type="image/svg+xml" />
  <title>{Astro.props.title || "明州 · AI Coding 实验手册"}</title>
</head>
<body>
  <header class="topbar">
    <a class="brand" href={BASE + "/"}>
      <span class="brand-mark">明</span>
      <span class="brand-text">
        <strong>明州 · AI Coding 实验手册</strong>
        <em>GStack 八环 · 三篇实操 · 五套向导</em>
      </span>
    </a>
    <nav class="top-links">
      <a href={BASE + "/handbook/00/"}>正文</a>
      <a href={BASE + "/demo/fruitlab/"}>演示</a>
      <a href={BASE + "/wizard/fruitlab/"}>向导</a>
      <a href={BASE + "/kit/"}>素材</a>
      <a class="pill" href={BASE + "/search/"}>检索</a>
    </nav>
  </header>

  <div class="layout">
    <aside class="sidenav">
      <p class="nav-cap">手册正文</p>
      <ul class="nav-list">
        {docs.map((d, i) => (
          <li class={"nav-item " + (tints[i] || "c1") + (current === d.slug ? " active" : "")}>
            <a href={BASE + "/handbook/" + d.slug + "/"}>
              <span class="dot" />
              <span>{d.title}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="nav-cap">实验向导</p>
      <ul class="nav-list compact">
        {tools.map((t) => (
          <li class={"nav-item" + (current === t.key ? " active" : "")}>
            <a href={t.href}><span class="dot" /><span>{t.label}</span></a>
          </li>
        ))}
      </ul>

      <div class="nav-foot">
        <span class="badge">v1.0</span>
        <a href={BASE + "/v1.0/"}>版本说明</a>
      </div>
    </aside>

    <main class="content">
      <slot />
    </main>
  </div>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll(".prose pre").forEach(function (pre) {
        if (pre.parentElement.classList.contains("code-wrap")) return;
        var wrap = document.createElement("div");
        wrap.className = "code-wrap";
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        var btn = document.createElement("button");
        btn.className = "copy-btn";
        btn.type = "button";
        btn.textContent = "复制";
        btn.addEventListener("click", function () {
          var code = pre.querySelector("code");
          var text = (code || pre).innerText;
          var done = function () { btn.textContent = "已复制"; setTimeout(function () { btn.textContent = "复制"; }, 1600); };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(function () { btn.textContent = "复制失败"; });
          } else {
            var ta = document.createElement("textarea");
            ta.value = text; document.body.appendChild(ta); ta.select();
            try { document.execCommand("copy"); done(); } catch (e) { btn.textContent = "复制失败"; }
            document.body.removeChild(ta);
          }
        });
        wrap.appendChild(btn);
      });
    });
  </script>
</body>
</html>
