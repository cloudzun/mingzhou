---
import MingShell from "../layouts/MingShell.astro";
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

const parts = [
  { k: "FOUNDATION", t: "0. 环境准备", c: "var(--c0)", h: BASE + "/handbook/00/",
    d: "gstack 是什么、怎么装到你的宿主、五条纪律与两条硬红线。" },
  { k: "PART ONE", t: "1. gstack 流程初探", c: "var(--c1)", h: BASE + "/handbook/01/",
    d: "A 观察四幕演示 · B 复现最终效果 · C 白手起家做水果店。" },
  { k: "PART TWO", t: "2. 做一个 AI 应用", c: "var(--c2)", h: BASE + "/handbook/02/",
    d: "判型四问 → 卡一 RAG 完整实操 → 卡二卡三入口 → 诚实清单。" },
  { k: "PART THREE", t: "3. 搬回自己的课题", c: "var(--c3)", h: BASE + "/handbook/03/",
    d: "判型、瘦身、造数、红线、受控行动、Day-2 与交卷。" }
];

const kits = [
  { t: "四幕演示", d: "R1 → R3.5 四幕可点，看八环如何运转、每幕被什么问题逼出来。", h: BASE + "/demo/fruitlab/" },
  { t: "水果店起手引导", d: "一句话需求加四条约束，生成可粘贴的启动提示词与驱动指令。", h: BASE + "/wizard/fruitlab/" },
  { t: "自选项目参考引导", d: "判型、瘦身、造数三步走完，产出可直接粘进 SPEC 的结论。", h: BASE + "/wizard/project/" },
  { t: "案例向导 · 三张卡", d: "知识问答、数据问数、合同审查三条案例线，七步填空加红线体检。", h: BASE + "/wizard/rag/" },
  { t: "素材与指纹", d: "三套 starter-kit 的内容清单、硬校验值与下载入口。", h: BASE + "/kit/" },
  { t: "检索与打印", d: "站内检索术语与门禁；整本 A4 打印视图。", h: BASE + "/search/" }
];
---

<MingShell current="home" title="AI Coding 实验 · 一站式手册与向导">
  <section class="hero">
    <h1>AI Coding 实验 · 一站式手册与向导</h1>
    <p>把 GStack 八环讲成可执行步骤：四份正文负责判断，一个演示负责直觉，五套向导负责手把手，三套素材包负责开工底座。</p>
    <div class="tags">
      <span class="tag">四份正文</span>
      <span class="tag">五套向导</span>
      <span class="tag">三套素材包</span>
      <span class="tag">可打印成册</span>
    </div>
  </section>

  <p class="section-cap">手册 · 按顺序读，或直接跳到所在阶段</p>
  <section class="cards cards-2">
    {parts.map((p) => (
      <a class="card" href={p.h} style={"--accent:" + p.c}>
        <span class="k">{p.k}</span>
        <h3>{p.t}</h3>
        <p>{p.d}</p>
      </a>
    ))}
  </section>

  <p class="section-cap">实操与工具 · 课上跟做、课后自练</p>
  <section class="cards">
    {kits.map((k) => (
      <a class="card" href={k.h}>
        <h3>{k.t}</h3>
        <p>{k.d}</p>
      </a>
    ))}
  </section>
</MingShell>
