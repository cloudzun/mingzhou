---
import MingShell from "../layouts/MingShell.astro";
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<MingShell current="search" title="全文检索">
  <h1>全文检索</h1>
  <p class="lede">静态索引（Pagefind），构建期生成，无服务端。</p>
  <link href={BASE + "/pagefind/pagefind-ui.css"} rel="stylesheet" />
  <div id="search"></div>
  <script src={BASE + "/pagefind/pagefind-ui.js"} is:inline></script>
  <script is:inline define:vars={{ base: BASE }}>
    window.addEventListener("DOMContentLoaded", function () {
      new PagefindUI({ element: "#search", baseUrl: base + "/pagefind/", showSubResults: true });
    });
  </script>
</MingShell>
