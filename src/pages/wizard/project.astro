---
import MingShell from "../../layouts/MingShell.astro";
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MingShell current="project" title="自选项目参考引导">
  <h1>自选项目参考引导</h1>
  <p class="lede">对应第三篇 3-1 判型、3-2 瘦身、3-3 造数。三步填完，得到可直接粘进 SPEC 的判型结论、不做清单与造数骨架。</p>

  <h2>第一步 · 判型</h2>
  <div class="wz-field">
    <label for="topic">课题名</label>
    <input id="topic" type="text" placeholder="例：政企专线能耗稽核平台" />
  </div>
  <div class="wz-field">
    <label for="goal">一句话目标</label>
    <input id="goal" type="text" placeholder="例：按阶梯单价抓出超上限计费的专线" />
  </div>

  <div id="qs"></div>
  <button id="gen1" class="wz-btn">生成判型结论</button>

  <div class="prose wz-out" id="out1" hidden>
    <pre><code id="r1"></code></pre>
  </div>

  <h2>第二步 · 瘦身（三步拆骨刀）</h2>
  <div class="wz-field">
    <label for="subs">子模块（每行一个，3–5 个）</label>
    <textarea id="subs" rows="4" placeholder="数据接入&#10;前置解析&#10;规则稽核&#10;大屏可视化"></textarea>
  </div>
  <div class="wz-field">
    <label for="core">主核（选一个，其余进不做清单）</label>
    <select id="core"></select>
  </div>
  <button id="gen2" class="wz-btn">生成不做清单与三类用例</button>

  <div class="prose wz-out" id="out2" hidden>
    <pre><code id="r2"></code></pre>
  </div>

  <h2>第三步 · 造数骨架</h2>
  <div class="wz-field">
    <label for="scale">主核规模（表数或语料份数）</label>
    <input id="scale" type="number" min="1" max="60" value="5" />
  </div>
  <button id="gen3" class="wz-btn">生成目录骨架与指纹清单</button>

  <div class="prose wz-out" id="out3" hidden>
    <pre><code id="r3"></code></pre>
  </div>

  <script is:inline>
    const QS = [
      { id: "q0", t: "Q0 需要调用外部工具修改单据或下发变更（有状态副作用）吗？", a: ["要", "不要"] },
      { id: "q1", t: "Q1 结论能否算完直接比对（结果集、聚合值、排名，不需逐条规则核查）？", a: ["能", "不能"] },
      { id: "q2", t: "Q2 手上有没有可枚举的核查规则或基线清单？", a: ["有", "没有"] },
      { id: "q3", t: "Q3 同一句结论换个立场会反转吗？", a: ["会", "不会"] }
    ];
    const st = {};
    const qbox = document.getElementById("qs");
    QS.forEach(function (q) {
      const d = document.createElement("div");
      d.className = "wz-q";
      d.innerHTML = "<p>" + q.t + "</p>" + q.a.map(function (v) {
        return '<button type="button" class="opt" data-q="' + q.id + '" data-v="' + v + '">' + v + "</button>";
      }).join("");
      qbox.appendChild(d);
    });
    qbox.addEventListener("click", function (e) {
      const b = e.target.closest("button.opt");
      if (!b) return;
      st[b.dataset.q] = b.dataset.v;
      b.parentElement.querySelectorAll("button.opt").forEach(function (x) { x.classList.remove("sel"); });
      b.classList.add("sel");
    });

    function judge() {
      if (st.q0 === "要") return { t: "象限 D 受控行动", g: "Tier 1/2/3 分流 + Dry-Run 预演闸", r: "沙盒最终状态一致 + 轨迹 P/R + pass^3" };
      if (st.q1 === "能") return { t: "象限 A 问数", g: "五道只读闸（意图、表列白名单、只读连接、单语句、LIMIT）", r: "EX 执行结果集一致率" };
      if (st.q2 === "有" && st.q3 === "会") return { t: "象限 B 稽查（规则约束）", g: "确定性引擎 + 立场声明 + 证据门禁", r: "判定单元（对象×规则）P/R 成对" };
      return { t: "象限 C 规程问答", g: "生效元数据过滤 + 重排阈值拒答", r: "条款召回@5 + 最小事实点 + 断言级零幻觉" };
    }

    document.getElementById("gen1").addEventListener("click", function () {
      const topic = document.getElementById("topic").value.trim() || "（未填课题名）";
      const goal = document.getElementById("goal").value.trim() || "（未填目标）";
      if (Object.keys(st).length < 4) { alert("四问都要答完"); return; }
      const j = judge();
      document.getElementById("r1").textContent =
        "课题：" + topic + "\n目标：" + goal + "\n\n" +
        "判型结论：我属于 " + j.t + "；主闸放在 " + j.g + "；主尺子是 " + j.r + "。\n\n" +
        "下一步：把这条结论抄进 SPEC.md 开头，再写 NOT in scope。";
      document.getElementById("out1").hidden = false;
    });

    const subs = document.getElementById("subs");
    const core = document.getElementById("core");
    function refreshCore() {
      const list = subs.value.split("\n").map(function (x) { return x.trim(); }).filter(Boolean);
      core.innerHTML = list.map(function (x, i) { return '<option value="' + i + '">' + x + "</option>"; }).join("");
    }
    subs.addEventListener("input", refreshCore);
    refreshCore();

    document.getElementById("gen2").addEventListener("click", function () {
      const list = subs.value.split("\n").map(function (x) { return x.trim(); }).filter(Boolean);
      if (list.length < 2) { alert("至少填 2 个子模块"); return; }
      const idx = Number(core.value || 0);
      const main = list[idx];
      const rest = list.filter(function (_, i) { return i !== idx; });
      const lines = [
        "主核（本次唯一交付）：" + main,
        "",
        "NOT in scope（不做清单，逐条写进 SPEC.md 并登记决策记录）："
      ].concat(rest.map(function (x, i) { return "  " + (i + 1) + ". " + x + " —— 代价：本轮不做，验收不含此项"; }));
      lines.push(
        "",
        "三类必演证据（半天 6 真机演示用）：",
        "  用例 1 正向抓异常：在预埋样本里检出 1 个典型异常，给完整证据链（原文 + 定位）。",
        "  用例 2 边界守分寸：条件缺失或口径歧义时不瞎猜，触发反问、默认声明或转人工。",
        "  用例 3 安全硬拦截：越权写操作或高危指令被确定性闸门拦下，并打印命中的规则号。",
        "",
        "提醒：名字里带「平台 / 中心 / 全流程」的，先拆再报；拆不开不许开工。"
      );
      document.getElementById("r2").textContent = lines.join("\n");
      document.getElementById("out2").hidden = false;
    });

    document.getElementById("gen3").addEventListener("click", function () {
      const n = Math.max(1, Math.min(60, Number(document.getElementById("scale").value || 5)));
      const tree = [
        "starter-kit/",
        "├── README-素材说明.md        起点说明 + 四类指纹",
        "├── contracts/契约.md          输入输出 + 检出/未检出/需人工 三态",
        "├── data/ 或 db/",
        "│   ├── build_starter_data.py  造数脚本（自己写；三套现成包里都没有）",
        "│   ├── EMBEDDED_CASES.json    8–10 类具名业务异常",
        "│   ├── schema.sql             " + Math.min(n, 6) + " 张表，每表 6–10 字段",
        "│   └── manifest.json          素材清单 + sha256（数据指纹落这里）",
        "├── eval/",
        "│   ├── starter_set.jsonl      20 题：正向 8 / 异常 6 / 歧义 3 / 高危 3",
        "│   ├── README-口径.md         每题判什么、怎么算分",
        "│   └── check_starter.py       四类指纹校验",
        "└── tools/                     仅象限 D：Tier 1 探针 + Tier 2 preview 桩"
      ];
      const fps = [
        "",
        "四类指纹（写进 check_starter.py）：",
        "  1 数据指纹：数据文件或语料目录的 sha256（落在 manifest.json）",
        "  2 规模指纹：核心表总行数 + EMBEDDED_CASES 预埋异常条数（目标 8–10 类）",
        "  3 锚点指纹：3 个黄金基准值（全库在网有效数、预埋违规金额、高危规则条数）",
        "  4 评测集指纹：恰好 20 题，四桶配额完整（8 / 6 / 3 / 3）",
        "",
        "20 题配比：常规正向 8 · 预埋异常命中 6 · 口径歧义与信息缺失 3 · 越权与高危拦截 3",
        "校验命令：python eval/check_starter.py（全 PASS 才开工）"
      ];
      document.getElementById("r3").textContent = tree.concat(fps).join("\n");
      document.getElementById("out3").hidden = false;
    });
  </script>
</MingShell>
