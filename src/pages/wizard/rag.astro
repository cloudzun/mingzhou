    <div class="frame-bar">
      <a href={BASE + "/"}>← 返回手册</a>
      <strong>知识问答向导</strong>
      <a class="open" href={BASE + "/wizards/rag.html"} target="_blank" rel="noopener">新窗口打开 ↗</a>
    </div>
    <iframe src={BASE + "/wizards/rag.html"} title="知识问答向导"></iframe>
  </div>
</MingShell>
