---
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>判型工具 · 明州 AI Coding 手册</title>
<style is:global>@import "/src/styles/global.css";</style>
<style>button.opt{margin-right:8px;padding:5px 12px;border:1px solid var(--line);border-radius:6px;background:var(--bg);cursor:pointer}</style>
</head><body>
<header class="top"><a class="brand" href="${BASE}/">明州 · AI Coding 实验手册</a>
<nav class="topnav"><a href="${BASE}/handbook/00/">正文</a><a href="${BASE}/demo/fruitlab">演示</a>
<a href="${BASE}/wizard/fruitlab">向导</a><a href="${BASE}/kit">素材</a><a href="${BASE}/search">搜索</a></nav></header>
<main class="main" style="max-width:760px;margin:0 auto;padding:28px 20px 80px">
<h1>判型工具：四问定象限</h1>
<p class="lede">对应手册 2-1 / 3-1：先问有没有状态副作用，再问能不能算完直接比对。</p>
<div id="q"></div>
<div id="out" style="margin-top:18px;padding:14px;border:1px solid var(--line);border-radius:8px;display:none">
<strong>结论</strong><pre id="res" style="white-space:pre-wrap;margin:8px 0 0"></pre>
<button id="copy" class="opt" style="margin-top:10px">复制</button></div>
<script>
const QS=[{id:'q0',t:'Q0 要调用外部工具修改单据或下发变更（有状态副作用）吗？',a:['要','不要']},
{id:'q1',t:'Q1 结论能否算完直接比对（结果集/聚合值/排名，不需逐条规则核查）？',a:['能','不能']},
{id:'q2',t:'Q2 手上有没有可枚举的核查规则或基线清单？',a:['有','没有']},
{id:'q3',t:'Q3 同一句结论换个立场会反转吗？',a:['会','不会']}];
const st={};const box=document.getElementById('q');
QS.forEach(function(q){var d=document.createElement('div');d.style.margin='12px 0';
d.innerHTML='<p style="margin:0 0 6px">'+q.t+'</p>'+q.a.map(function(v){return '<button class="opt" data-q="'+q.id+'" data-v="'+v+'">'+v+'</button>';}).join('');
box.appendChild(d);});
function judge(){if(Object.keys(st).length<4)return;var t,g,r;
if(st.q0==='要'){t='象限 D 受控行动';g='Tier 1/2/3 分流 + Dry-Run 预演闸';r='沙盒最终状态一致 + 轨迹 P/R + pass^3';}
else if(st.q1==='能'){t='象限 A 问数';g='五道只读闸（意图/白名单/只读/单语句/LIMIT）';r='EX 执行结果集一致率';}
else if(st.q2==='有'&&st.q3==='会'){t='象限 B 稽查（规则约束）';g='确定性引擎 + 立场声明 + 证据门禁';r='判定单元（对象×规则）P/R 成对';}
else{t='象限 C 规程问答';g='生效元数据过滤 + 重排阈值拒答';r='条款召回@5 + 最小事实点 + 断言级零幻觉';}
document.getElementById('res').textContent='我属于 '+t+'；主闸放在 '+g+'；主尺子是 '+r+'。';
document.getElementById('out').style.display='block';}
box.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;st[b.dataset.q]=b.dataset.v;
b.parentElement.querySelectorAll('button').forEach(function(x){x.style.background='var(--bg)';});b.style.background='var(--soft)';judge();});
document.getElementById('copy').addEventListener('click',function(){navigator.clipboard.writeText(document.getElementById('res').textContent);});
</script></main>
</body></html>
