---
import { loadDocs, render } from "../../lib/docs.js";
import MingShell from "../../layouts/MingShell.astro";

export function getStaticPaths() {
  return loadDocs().map((d) => ({ params: { slug: d.slug }, props: { doc: d } }));
}

const { doc } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const docs = loadDocs();
const { html } = render(doc.body);
const idx = docs.findIndex((d) => d.slug === doc.slug);
---

<MingShell current={doc.slug} title={doc.title + " · 明州 AI Coding 手册"}>
  <p class="crumb">
    <span>
      {idx > 0
        ? <a href={BASE + "/handbook/" + docs[idx - 1].slug + "/"}>← {docs[idx - 1].title}</a>
        : <a href={BASE + "/"}>← 首页</a>}
    </span>
    <span>
      {idx < docs.length - 1
        ? <a href={BASE + "/handbook/" + docs[idx + 1].slug + "/"}>{docs[idx + 1].title} →</a>
        : null}
    </span>
  </p>
  <h1>{doc.title}</h1>
  <p class="lede">{doc.desc}</p>
  <div class="prose" set:html={html} />
</MingShell>
