---
import MingShell from "../../layouts/MingShell.astro";
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<MingShell current="triage" title="判型工具">
  <h1>判型工具：四问定象限</h1>
  <p class="lede">对应手册 2-1 与 3-1：先问有没有状态副作用，再问能不能算完直接比对。</p>
  <div id="q"></div>
  <div id="out" class="triage-out">
    <strong>结论</strong>
    <pre id="res"></pre>
    <button id="copy">复制结论</button>
  </div>
  <script is:inline>
    const QS = [
      { id: "q0", t: "Q0 要调用外部工具修改单据或下发变更（有状态副作用）吗？", a: ["要", "不要"] },
      { id: "q1", t: "Q1 结论能否算完直接比对（结果集、聚合值、排名，不需逐条规则核查）？", a: ["能", "不能"] },
      { id: "q2", t: "Q2 手上有没有可枚举的核查规则或基线清单？", a: ["有", "没有"] },
      { id: "q3", t: "Q3 同一句结论换个立场会反转吗？", a: ["会", "不会"] }
    ];
    const st = {};
    const box = document.getElementById("q");
    QS.forEach(function (q) {
      const d = document.createElement("div");
      d.className = "triage-q";
      d.innerHTML = "<p>" + q.t + "</p>" + q.a.map(function (v) {
        return '<button class="opt" data-q="' + q.id + '" data-v="' + v + '">' + v + "</button>";
      }).join("");
      box.appendChild(d);
    });
    function judge() {
      if (Object.keys(st).length < 4) return;
      let t, g, r;
      if (st.q0 === "要") { t = "象限 D 受控行动"; g = "Tier 1/2/3 分流 + Dry-Run 预演闸"; r = "沙盒最终状态一致 + 轨迹 P/R + pass^3"; }
      else if (st.q1 === "能") { t = "象限 A 问数"; g = "五道只读闸（意图、白名单、只读、单语句、LIMIT）"; r = "EX 执行结果集一致率"; }
      else if (st.q2 === "有" && st.q3 === "会") { t = "象限 B 稽查（规则约束）"; g = "确定性引擎 + 立场声明 + 证据门禁"; r = "判定单元（对象×规则）P/R 成对"; }
      else { t = "象限 C 规程问答"; g = "生效元数据过滤 + 重排阈值拒答"; r = "条款召回@5 + 最小事实点 + 断言级零幻觉"; }
      document.getElementById("res").textContent = "我属于 " + t + "；主闸放在 " + g + "；主尺子是 " + r + "。";
      document.getElementById("out").classList.add("on");
    }
    box.addEventListener("click", function (e) {
      const b = e.target.closest("button");
      if (!b) return;
      st[b.dataset.q] = b.dataset.v;
      b.parentElement.querySelectorAll("button").forEach(function (x) { x.classList.remove("sel"); });
      b.classList.add("sel");
      judge();
    });
    document.getElementById("copy").addEventListener("click", function () {
      navigator.clipboard.writeText(document.getElementById("res").textContent);
    });
  </script>
</MingShell>
